{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invalid/course-package/v1/course.schema.json",
  "title": "Course v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["course_id", "version", "language", "title", "description", "chapters", "metadata"],
  "properties": {
    "course_id": {"$ref": "#/$defs/id"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "language": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"}, "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"}, "chapters": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "metadata": {"type": "object", "additionalProperties": true}, "concepts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["concept_id", "kind", "label"], "properties": {"concept_id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["vocabulary", "grammar"]}, "label": {"type": "string", "minLength": 1}}}}, "assets": {"type": "array", "items": {"$ref": "asset.schema.json"}}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"}}
}
