{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.invalid/course-package/v1/asset.schema.json", "title": "Asset v1", "type": "object", "additionalProperties": false,
  "required": ["asset_id", "type", "mime_type", "path", "checksum", "version", "alt_text", "required", "status"],
  "properties": {
    "asset_id": {"$ref": "course.schema.json#/$defs/id"}, "type": {"enum": ["image", "audio"]}, "mime_type": {"enum": ["image/png", "image/jpeg", "image/webp", "audio/mpeg", "audio/wav", "audio/ogg"]}, "path": {"type": "string", "pattern": "^assets/(images|audio)/[A-Za-z0-9._-]+\\.(png|jpg|jpeg|webp|mp3|wav|ogg)$"}, "source_ref": {"type": ["string", "null"]}, "checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "duration_ms": {"type": "integer", "minimum": 1}, "alt_text": {"type": "string"}, "transcript": {"type": "string"}, "related_to": {"type": "array", "items": {"$ref": "course.schema.json#/$defs/id"}}, "required": {"type": "boolean"}, "status": {"enum": ["approved"]}
  }
}
