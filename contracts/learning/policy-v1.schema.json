{
  "$defs": {
    "ActivityRule": {
      "additionalProperties": false,
      "properties": {
        "accepted_responses": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/JsonValue"
              },
              "maxItems": 200,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Accepted Responses"
        },
        "comparison": {
          "enum": [
            "exact",
            "unordered"
          ],
          "title": "Comparison",
          "type": "string"
        },
        "display_choices": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 200,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Display Choices"
        },
        "display_prompt": {
          "anyOf": [
            {
              "maxLength": 16384,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Display Prompt"
        },
        "normalization": {
          "items": {
            "$ref": "#/$defs/Normalizer"
          },
          "maxItems": 8,
          "title": "Normalization",
          "type": "array"
        }
      },
      "required": [
        "comparison",
        "accepted_responses",
        "normalization",
        "display_prompt",
        "display_choices"
      ],
      "title": "ActivityRule",
      "type": "object"
    },
    "ConceptRule": {
      "additionalProperties": false,
      "properties": {
        "mastery_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,9}0*$",
              "type": "string"
            }
          ],
          "title": "Mastery Score"
        },
        "required_lessons": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$",
            "type": "string"
          },
          "maxItems": 2000,
          "minItems": 1,
          "title": "Required Lessons",
          "type": "array"
        }
      },
      "required": [
        "required_lessons",
        "mastery_score"
      ],
      "title": "ConceptRule",
      "type": "object"
    },
    "JsonValue": {},
    "LessonRule": {
      "additionalProperties": false,
      "properties": {
        "completion_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,9}0*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Completion Score"
        },
        "mastery_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,9}0*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mastery Score"
        },
        "require_evaluation": {
          "title": "Require Evaluation",
          "type": "boolean"
        },
        "required_activities": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$",
            "type": "string"
          },
          "maxItems": 200,
          "title": "Required Activities",
          "type": "array"
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewRule"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "required_activities",
        "require_evaluation",
        "completion_score",
        "mastery_score",
        "review"
      ],
      "title": "LessonRule",
      "type": "object"
    },
    "Normalizer": {
      "additionalProperties": false,
      "properties": {
        "flag": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Flag",
          "type": "string"
        },
        "operation": {
          "enum": [
            "trim",
            "case_fold",
            "unicode_nfc"
          ],
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "flag",
        "operation"
      ],
      "title": "Normalizer",
      "type": "object"
    },
    "PlacementBand": {
      "additionalProperties": false,
      "properties": {
        "lesson_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$",
          "title": "Lesson Id",
          "type": "string"
        },
        "minimum_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,9}0*$",
              "type": "string"
            }
          ],
          "title": "Minimum Score"
        }
      },
      "required": [
        "minimum_score",
        "lesson_id"
      ],
      "title": "PlacementBand",
      "type": "object"
    },
    "PlacementRule": {
      "additionalProperties": false,
      "properties": {
        "activity_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$",
            "type": "string"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Activity Ids",
          "type": "array"
        },
        "assessment_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "title": "Assessment Version",
          "type": "string"
        },
        "recommendations": {
          "items": {
            "$ref": "#/$defs/PlacementBand"
          },
          "maxItems": 2000,
          "minItems": 1,
          "title": "Recommendations",
          "type": "array"
        }
      },
      "required": [
        "assessment_version",
        "activity_ids",
        "recommendations"
      ],
      "title": "PlacementRule",
      "type": "object"
    },
    "ReviewRule": {
      "additionalProperties": false,
      "properties": {
        "intervals_seconds": {
          "items": {
            "maximum": 31536000,
            "minimum": 60,
            "type": "integer"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Intervals Seconds",
          "type": "array"
        },
        "on_failure": {
          "enum": [
            "reset",
            "retain"
          ],
          "title": "On Failure",
          "type": "string"
        },
        "success_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,9}0*$",
              "type": "string"
            }
          ],
          "title": "Success Score"
        }
      },
      "required": [
        "intervals_seconds",
        "success_score",
        "on_failure"
      ],
      "title": "ReviewRule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "activities": {
      "maxProperties": 2000,
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$": {
          "$ref": "#/$defs/ActivityRule"
        }
      },
      "title": "Activities",
      "type": "object"
    },
    "concepts": {
      "maxProperties": 2000,
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$": {
          "$ref": "#/$defs/ConceptRule"
        }
      },
      "title": "Concepts",
      "type": "object"
    },
    "lessons": {
      "maxProperties": 2000,
      "minProperties": 1,
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$": {
          "$ref": "#/$defs/LessonRule"
        }
      },
      "title": "Lessons",
      "type": "object"
    },
    "package_policy_inputs": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Package Policy Inputs",
      "type": "object"
    },
    "placement": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlacementRule"
        },
        {
          "type": "null"
        }
      ]
    },
    "policy_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
      "title": "Policy Version",
      "type": "string"
    }
  },
  "required": [
    "policy_version",
    "lessons",
    "activities",
    "concepts",
    "placement",
    "package_policy_inputs"
  ],
  "title": "LearningPolicy",
  "type": "object"
}
