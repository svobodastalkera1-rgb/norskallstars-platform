# Local example only; the application does not implicitly read .env files.
# scripts/phase1.py init generates an ignored local password without printing it.
NORSKALLSTARS_ENV=local
NORSKALLSTARS_LOG_LEVEL=INFO
NORSKALLSTARS_DATABASE_HOST=127.0.0.1
NORSKALLSTARS_DATABASE_PORT=5433
NORSKALLSTARS_DATABASE_NAME=norskallstars_local
NORSKALLSTARS_DATABASE_USER=norskallstars_dev
NORSKALLSTARS_DATABASE_PASSWORD=
NORSKALLSTARS_DATABASE_SSLMODE=disable
NORSKALLSTARS_ALLOWED_HOSTS=["localhost","127.0.0.1"]
NORSKALLSTARS_CORS_ORIGINS=[]
NORSKALLSTARS_STORAGE_BACKEND=disabled
# Staging/production must supply a strong password, explicit host allowlist,
# verified database TLS and a mounted CA file. Local storage and DEBUG are rejected.
# NORSKALLSTARS_DATABASE_SSLMODE=verify-full
# NORSKALLSTARS_DATABASE_SSLROOTCERT=/mounted/ca.crt

# Required independent runtime secrets; generate locally with scripts/phase1.py init.
NORSKALLSTARS_IDENTITY_PEPPER=
NORSKALLSTARS_IDENTITY_MAIL_KEY=
NORSKALLSTARS_IDENTITY_PUBLIC_ORIGIN=http://localhost:3000
NORSKALLSTARS_GOOGLE_CLIENT_IDS=[]
NORSKALLSTARS_MAIL_TRANSPORT=outbox
# Staging/production require explicit Google Web/Android audiences, HTTPS origin
# and authenticated SMTP over TLS (implicit TLS, default 465). Never bake secrets in images.
# NORSKALLSTARS_MAIL_TRANSPORT=smtp
# NORSKALLSTARS_SMTP_HOST=smtp.example.invalid
# NORSKALLSTARS_SMTP_PORT=465
# NORSKALLSTARS_SMTP_USERNAME=
# NORSKALLSTARS_SMTP_PASSWORD=
# NORSKALLSTARS_MAIL_SENDER=noreply@example.com

# Phase 5: external configuration only. Browser build identifiers are public.
# No credentials may use the VITE_ prefix: Vite includes those values in browser JS.
# VITE_GOOGLE_CLIENT_ID=your-public-web-client-id.apps.googleusercontent.com
# Built image sets WEB_ROOT; source runtime may set an absolute apps/web/dist path.
# NORSKALLSTARS_WEB_ROOT=/absolute/public-build-directory
# Explicit browser origin must match the served site; no wildcard or cookie transport.
# NORSKALLSTARS_IDENTITY_PUBLIC_ORIGIN=http://127.0.0.1:8000
NORSKALLSTARS_VOICE_SAMPLE_RATE=0
NORSKALLSTARS_STORAGE_GC_GRACE_SECONDS=3600
# S3 credentials come from the runtime secret manager, never the image/build context.
# Bucket must be private; isolated staging must verify encryption/denied anonymous reads.
# NORSKALLSTARS_STORAGE_BACKEND=s3
# NORSKALLSTARS_S3_ENDPOINT=https://storage.example.invalid
# NORSKALLSTARS_S3_BUCKET=example-private-bucket
# NORSKALLSTARS_S3_REGION=example-region
# NORSKALLSTARS_S3_ACCESS_KEY=
# NORSKALLSTARS_S3_SECRET_KEY=
